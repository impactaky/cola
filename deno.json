{
  "tasks": {
    "cola": "deno run --allow-run=codex,ps,git --allow-read --allow-write --allow-env --allow-net=127.0.0.1,localhost src/main.ts",
    "check": "deno fmt --check && deno lint && deno check src/main.ts",
    "fmt": "deno fmt"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.0.1"
  }
}
